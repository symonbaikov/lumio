# Lumio environment variables
# Development mode is prepared by `npm run setup:dev` or `npm run setup:env`.
# The generated .env file is ignored by git and can be edited locally.

# Development defaults:
POSTGRES_USER=finflow
POSTGRES_PASSWORD=finflow
POSTGRES_DB=finflow
POSTGRES_PORT=5434
REDIS_PORT=6379
# Used by the cache and by the statement-parsing queue. When running the backend
# outside Docker, point this at the mapped host port (see REDIS_PORT).
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production; generated locally for development:
# JWT_SECRET=<run: openssl rand -base64 32>
# JWT_REFRESH_SECRET=<run: openssl rand -base64 32>
# INTEGRATIONS_ENCRYPTION_KEY=<run: openssl rand -base64 32>
# BACKUP_MASTER_KEY=<run: openssl rand -base64 32>
# BACKUP_LOCAL_ROOT=/var/lib/lumio/backups

# Required for crypto wallet sync (free key from https://etherscan.io/apis):
# ETHERSCAN_API_KEY=<your Etherscan V2 API key>

# Required when Telegram webhook integration is enabled:
# TELEGRAM_WEBHOOK_SECRET=<run: openssl rand -base64 32>

# User-managed integrations are configured in the UI:
# AI-compatible endpoint, SMTP, S3-compatible storage, WebDAV, IMAP, Telegram, and App URL.
# Env integration values are supported only as temporary bootstrap/fallback defaults.
